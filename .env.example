# Copy this to .env in the project root. docker-compose.yml reads these
# automatically. Every section below tells you exactly where to get the
# value -- see README.md "Setup guide" for the full click-by-click steps.

# --- Supabase (Settings -> Database -> Connection string, "URI" tab;
# and Settings -> API for the URL + anon key) -----------------------------
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
LLM_PROVIDER=groq

GROQ_API_KEY=


# --- Azure Storage (Storage Account -> Access keys -> Connection string) -
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=saans-lake

# --- Snowflake  -------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# --- Databricks (workspace -> Settings -> Developer -> Access tokens) ----
DATABRICKS_HOST=
DATABRICKS_TOKEN= 
DATABRICKS_JOB_ID=
